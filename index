  sec("1. Identificação");
  kv("Cliente",p.ident.cliente); kv("Projeto",p.ident.projeto); kv("Tipo",p.ident.tipo);
  kv("Endereço",p.ident.endereco); kv("Cidade",p.ident.cidade); kv("Estado",p.ident.estado); kv("CEP",p.ident.cep);
