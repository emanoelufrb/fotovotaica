  kv("V_OC,string a frio (V)",fmt(C.vocStringFrio,1)); kv("V_MP,string a quente (V)",fmt(C.vmpStringQuente,1));
  kv("I_string (A)",fmt(C.iString,2)); kv("I_SC,string (A)",fmt(C.iscString,2));

